<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="en-US">
  <info>
    <title>Skripsi Teknologi Pangan (Penulis et al., Tahun)</title>
    <title-short>Skripsi Tekpang</title-short>
    <id>http://www.zotero.org/styles/skripsi-teknologi-pangan-thesis</id>
    <author>
      <name>Ade Septiana</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>Sitasi (Penulis et al., Tahun) dengan koma sebelum tahun, et al. miring. Daftar pustaka: Penulis. Tahun. Judul. Jurnal. Vol. V(N): hlm. (jurnal) dan Penulis. Tahun. Judul. Edisi. Penerbit. Kota. N p. (buku).</summary>
    <updated>2026-11-04T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="and">dan</term>
      <term name="et-al">et al.</term>
      <term name="accessed">Diakses</term>
      <term name="no date" form="short">t.t.</term>
    </terms>
  </locale>

  <!-- ============ MAKROS ============ -->

  <macro name="author-cite">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <!-- Contoh: Schulz, C., Engel, U., Biesalski, HK. -->
  <macro name="author-bib">
    <names variable="author" suffix=".">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="" delimiter="., " delimiter-precedes-last="always"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor-bib">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="" delimiter="., " delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=".)"/>
    </names>
  </macro>

  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="journal-name">
    <choose>
      <if variable="container-title-short">
        <text variable="container-title-short"/>
      </if>
      <else>
        <text variable="container-title"/>
      </else>
    </choose>
  </macro>

  <!-- Vol. 46(1): 12-20 -->
  <macro name="vol-issue-pages">
    <group>
      <group delimiter=" ">
        <text value="Vol."/>
        <group>
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
        </group>
      </group>
      <text variable="page" prefix=": "/>
    </group>
  </macro>

  <macro name="edition-volume">
    <group delimiter=". ">
      <choose>
        <if is-numeric="edition">
          <group delimiter=" ">
            <text value="Edisi"/>
            <text variable="edition"/>
          </group>
        </if>
        <else>
          <text variable="edition"/>
        </else>
      </choose>
      <group delimiter=" ">
        <text value="Jilid"/>
        <text variable="volume"/>
      </group>
    </group>
  </macro>

  <macro name="pages-book">
    <choose>
      <if variable="number-of-pages">
        <text variable="number-of-pages" suffix=" p."/>
      </if>
      <else-if variable="page">
        <text variable="page" suffix=" p."/>
      </else-if>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <text term="accessed"/>
          <date variable="accessed">
            <date-part name="day" suffix=" "/>
            <date-part name="month" suffix=" "/>
            <date-part name="year"/>
          </date>
          <text variable="URL"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- ============ SITASI ============ -->

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="false">
    <sort>
      <key macro="author-cite"/>
      <key macro="year"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <!-- VARIAN: pemisah penulis dan tahun -->
      <group delimiter=", ">
        <text macro="author-cite"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>

  <!-- ============ DAFTAR PUSTAKA ============ -->

  <bibliography hanging-indent="true" et-al-min="21" et-al-use-first="19" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author-bib"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author-bib"/>
        <text macro="year" suffix="."/>
        <choose>
          <!-- JURNAL: Penulis. Tahun. Judul (miring). Jurnal. Vol. V(N): hlm. -->
          <if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=" ">
              <text variable="title" font-style="italic" suffix="."/>
              <text macro="journal-name" suffix="."/>
              <text macro="vol-issue-pages" suffix="."/>
            </group>
          </if>
          <!-- BUKU: Penulis. Tahun. Judul. Edisi/Jilid. Penerbit. Kota. N p. -->
          <else-if type="book" match="any">
            <group delimiter=" ">
              <text variable="title" suffix="."/>
              <text macro="edition-volume" suffix="."/>
              <text variable="publisher" suffix="."/>
              <text variable="publisher-place" suffix="."/>
              <text macro="pages-book"/>
            </group>
          </else-if>
          <else-if type="chapter paper-conference" match="any">
            <group delimiter=" ">
              <text variable="title" suffix="."/>
              <group delimiter=" " suffix=".">
                <text value="Dalam:"/>
                <text macro="editor-bib"/>
                <text variable="container-title" font-style="italic"/>
              </group>
              <text variable="publisher" suffix="."/>
              <text variable="publisher-place" suffix="."/>
              <text variable="page" prefix="hlm. " suffix="."/>
            </group>
          </else-if>
          <else-if type="thesis" match="any">
            <group delimiter=" ">
              <text variable="title" suffix="."/>
              <text variable="genre" suffix="."/>
              <text variable="publisher" suffix="."/>
              <text variable="publisher-place" suffix="."/>
            </group>
          </else-if>
          <else>
            <group delimiter=" ">
              <text variable="title" suffix="."/>
              <text variable="container-title" suffix="."/>
              <text variable="publisher" suffix="."/>
              <text macro="access"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
